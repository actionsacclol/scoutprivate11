{
  "compilerOptions": {
    "target": "ES2021",
    "lib": ["ES2021"],
    "module": "CommonJS",
    "moduleResolution": "Node",
    "strict": true,
    "noEmit": true,
    "noImplicitAny": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@shared/*": ["shared/*"]
    }
  },
  // Entry-based for the same reason as tsconfig.json: a stale file left
  // behind by a copy-paste deploy must not be able to break the build.
  // These are the exact entries vite-plugin-electron bundles from.
  "files": ["electron/main.ts", "electron/preload.ts", "vite.config.ts"]
}
