{
  "compilerOptions": {
    "target": "ES2021",
    "lib": ["ES2021", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    // tsc is typecheck-only here (vite/esbuild does all emitting). Without
    // this, a bare `tsc` run drops .js shadows beside every .tsx and Vite
    // silently builds from THOSE — the stale-bundle bug, twice now.
    "noEmit": true,
    "noImplicitAny": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "useDefineForClassFields": true,
    "baseUrl": ".",
    "paths": {
      "@shared/*": ["shared/*"]
    }
  },
  // Entry-based, not directory-based, ON PURPOSE. The repo is deployed by
  // copy-pasting the working tree over another checkout (several GitHub
  // accounts), and a copy never deletes anything: a module removed here
  // survives there as a stale file. With `include: ["src"]` that stale file
  // is typechecked and breaks the release build the moment it references a
  // type that no longer exists. Walking the import graph from the real
  // entry instead means a file nobody imports is a file nobody checks —
  // exactly what Vite bundles. Add new global .d.ts files to this list.
  "files": ["src/main.tsx", "src/global.d.ts"]
}
